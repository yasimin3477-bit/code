void callback(char* topic, byte* payload, unsigned int length) { // เมื่อได้รับข้อความจาก MQTT
  String message = "";                                     // ตัวแปรเก็บข้อความที่ได้
  for (int i = 0; i < length; i++) message += (char)payload[i]; // แปลง byte มาต่อเป็นข้อความ String

  DynamicJsonDocument doc(512);                            // สร้างตัวรับ JSON ขนาด 512 ไบต์
  DeserializationError error = deserializeJson(doc, message); // แปลง String คืนกลับเป็น JSON โครงสร้าง

  if (!error) {                                            // ถ้าแปลงสำเร็จไม่มีข้อผิดพลาด
    if (doc.containsKey("meal") && doc.containsKey("time")) { // และมีข้อมูล meal กับ time ส่งมา
      String meal = doc["meal"].as<String>();              // อ่านมื้อยา
      String time = doc["time"].as<String>();              // อ่านเวลาที่ต้องอัปเดต
      updateMealTime(meal, time);                          // อัปเดตเวลาทานยาผ่าน MQTT
    }
  }
}

void reconnectMQTT() {
  while (!client.connected()) {                            // ทำวนไปเรื่อยๆ จนกว่า MQTT จะต่อติด
    String clientId = "ESP32_PillDispenser_" + String(random(0xffff), HEX); // สุ่มชื่อ Client
    if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) { // ถ้าต่อติด
      client.subscribe(topic_status);                      // ให้เริ่มรอรับฟังข้อมูลหัวข้อ topic_status
    } else {
      delay(3000);                                         // ถ้าต่อไม่ติดให้รอ 3 วินาทีแล้วลองใหม่
    }
  }
}

// ================= SETUP (ตั้งค่าเริ่มต้นตอนเปิดเครื่อง) =================
void setup() {
  Serial.begin(115200);                                    // เปิดพอร์ต Serial ความเร็ว 115200

  pinMode(TRIG_PIN, OUTPUT);                               // เซ็นเซอร์อัลตราโซนิก ขาซ้ายสั่งปล่อยคลื่น (Output)
  pinMode(ECHO_PIN, INPUT);                                // เซ็นเซอร์อัลตราโซนิก ขาขวารับคลื่นสะท้อน (Input)
  pinMode(BUZZER_PIN, OUTPUT);                             // บัซเซอร์ (เสียง) ให้เป็นขาออก
  digitalWrite(BUZZER_PIN, LOW);                           // เริ่มต้นปิดเสียง
  
  // เซ็ตตำแหน่ง Servo ไปที่ 0 องศาตอนเริ่มต้น
  myServo.attach(SERVO_PIN);                               // ผูกขา Servo
  myServo.write(0);                                        // หมุนไปที่ศูนย์องศา
  delay(500);                                              // รอเซ็ตอัพครึ่งวินาที

  SPI.begin();                                             // เริ่มต้นการสื่อสาร SPI
  mfrc522.PCD_Init();                                      // เริ่มต้นโมดูล RFID

  WiFi.begin(ssid, password);                              // สั่งเชื่อมต่อ WiFi ด้วยข้อมูลที่ตั้งไว้
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {                  // รอจนกว่าจะต่อ WiFi เสร็จ
    delay(500);                                            // รอทีละ 0.5 วิ
    Serial.print(".");                                     // พิมพ์จุดเพื่อบอกว่ากำลังทำงาน
  }
  
  Serial.println("\nWiFi Connected!");                     // พิมพ์บอกว่าต่อ WiFi สำเร็จ
  Serial.print("🌐 เข้าหน้าเว็บได้ที่ IP: http://");           
  Serial.println(WiFi.localIP());                          // แสดง IP ของ ESP32 เพื่อเข้าหน้าเว็บ

  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer1, ntpServer2); // สั่งซิงค์เวลาจากอินเทอร์เน็ต

  client.setServer(mqtt_server, mqtt_port);                // กำหนดที่อยู่และพอร์ต MQTT
  client.setCallback(callback);                            // ตั้งฟังก์ชันที่จะถูกเรียกเมื่อมีข้อมูลใหม่เข้ามาใน MQTT
  botClient.setInsecure();                                 // ปิดการตรวจสอบใบรับรอง SSL ชั่วคราวเพื่อให้ Telegram ต่อติดง่ายๆ

  server.on("/", handleRoot);                              // หากเข้าผ่านหน้าเว็บ / จะให้เรียกฟังก์ชัน handleRoot
  server.begin();                                          // เริ่มเปิดเซิร์ฟเวอร์เว็บ
  Serial.println("HTTP Server Started");                   // แจ้งใน Serial

  soundSuccess();                                          // เปิดเสียงตื๊ดๆ ยืนยันเครื่องเปิดสมบูรณ์
  
  String startMsg = "🚀 [System Ready] ระบบจ่ายยาออนไลน์แล้ว!\n"; // สร้างข้อความต้อนรับ
  startMsg += "🌐 IP หน้าเว็บ: http://" + WiFi.localIP().toString(); // แนบ IP ในข้อความ
  bot.sendMessage(CHAT_ID, startMsg, "");                  // ส่งข้อความไปที่ Telegram
}

// ================= LOOP (ลูปทำงานวนซ้ำหลัก) =================
void loop() {
  server.handleClient();                                   // จัดการคำขอ (Request) จาก Web Server อย่างต่อเนื่อง

  if (!client.connected()) {                               // ถ้าหลุดจากเซิร์ฟเวอร์ MQTT
    reconnectMQTT();                                       // พยายามเชื่อมต่อใหม่
  }
  client.loop();                                           // รักษาและอัปเดตการเชื่อมต่อ MQTT (ห้ามเอาออก)

  checkDayReset();                                         // ตรวจสอบว่าขึ้นวันใหม่หรือยัง ถ้าขึ้นแล้วจะรีเซ็ตสถานะ
  checkPillTimeAlerts();                                   // ตรวจสอบเวลาปัจจุบันว่าถึงเวลาต้องเตือนกินยาหรือไม่

  if (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial()) { // ตรวจสอบว่ามีบัตรมาแตะหรือไม่
    return;                                                // ถ้าไม่มีให้ออกจากลูปวนไปเริ่มใหม่ด้านบน
  }

  String scannedUID = "";                                  // สร้างตัวแปรเก็บรหัสบัตรที่อ่านได้
  for (byte i = 0; i < mfrc522.uid.size; i++) {            // วนลูปอ่านข้อมูลทีละไบต์จากบัตร
    scannedUID += String(mfrc522.uid.uidByte[i] < 0x10 ? "0" : ""); // ถ้าไบต์น้อยกว่า 0x10 (16 ฐานสิบ) ให้เติม 0 ข้างหน้า
    scannedUID += String(mfrc522.uid.uidByte[i], HEX);     // นำรหัสมาแปลงเป็นรหัสฐานสิบหก 
    if (i < mfrc522.uid.size - 1) scannedUID += " ";       // เติมเว้นวรรคระหว่างไบต์ (แก้บรรทัดผิดใน prompt ให้เป็นตัวลบ)
  }
  scannedUID.toUpperCase();                                // แปลงรหัสบัตรเป็นตัวพิมพ์ใหญ่ทั้งหมด
  scannedUID.trim();                                       // ลบช่องว่างหัวท้าย

  String activeMeal = getValidMealNow();                   // เช็กว่าตอนที่บัตรแตะ เป็นเวลาของยา "มื้อไหน" ที่ต้องทาน

  if (scannedUID != AUTHORIZED_UID) {                      // ถ้าบัตรที่แตะ ไม่ตรงกับบัตรผู้ป่วยที่บันทึกไว้
    soundError();                                          // เสียงเตือนผิดพลาด
    sendRFIDLog("บัตรไม่ถูกต้อง", scannedUID);                // บันทึก Log เข้า MQTT ว่าแตะบัตรผิด
  } 
  else if (activeMeal == "none") {                         // ถ้าบัตรถูก แต่ไม่ใช่เวลากินยา 
    soundWarning();                                        // เสียงเตือนระวัง
    String nextMealName = "", nextMealTime = "";           // เตรียมตัวแปรบอกมื้อถัดไป
    getNextMealInfo(nextMealName, nextMealTime);           // ดึงข้อมูลว่ายาที่ต้องกินครั้งถัดไปคือตอนไหน
    sendRFIDLog("แตะก่อนเวลา", scannedUID, nextMealName, nextMealTime); // บันทึก Log ว่ามากินก่อนเวลา
  }
  else {                                                   // ถ้าบัตรถูก และถึงเวลากินยาแล้ว
    float distance = checkPillDistance();                  // วัดระยะทางในกล่องยาด้วยเซนเซอร์อัลตราโซนิก
    if (distance > 15.0) {                                 // ถ้าระยะเกิน 15cm หมายความว่ากล่องยาไม่อยู่
      soundWarning();                                      // เสียงเตือนระวัง
      sendRFIDLog("ไม่พบกล่องยา", scannedUID);                // บันทึก Log ว่าไม่เจอกล่องยา
    } 
    else {                                                 // กรณีกล่องยาอยู่พร้อมทำงานครบทุกอย่าง
      stopAlarm();                                         // หยุดการแจ้งเตือนเสียง
      String mealTH = "";                                  // ตัวแปรชื่อมื้อภาษาไทย
      if (activeMeal == "morning") {                       // กรณีเป็นมื้อเช้า
        morningTaken = true; morningDueNotified = true; morningOverdueNotified = true; mealTH = "มื้อเช้า"; // อัปเดตสถานะและหยุดการเตือนสำหรับมื้อนี้
      } else if (activeMeal == "noon") {                   // กรณีเป็นมื้อเที่ยง
        noonTaken = true; noonDueNotified = true; noonOverdueNotified = true; mealTH = "มื้อเที่ยง"; // อัปเดตสถานะมื้อเที่ยง
      } else if (activeMeal == "evening") {                // กรณีเป็นมื้อเย็น
        eveningTaken = true; eveningDueNotified = true; eveningOverdueNotified = true; mealTH = "มื้อเย็น"; // อัปเดตสถานะมื้อเย็น
      }

      soundSuccess();                                      // ส่งเสียงยืนยันว่าทำงานสำเร็จ
      dispensePill(activeMeal);                            // สั่งให้ Servo จ่ายยาตามองศาของมื้อนั้นๆ
      sendRFIDLog("จ่ายยาสำเร็จ", scannedUID);                // บันทึกการจ่ายยาลง Log

      String successMsg = "✅ [รับยาสำเร็จ] ได้ทำการแตะรับยา" + mealTH + " เรียบร้อยแล้ว\n⏰ เวลา: " + getCurrentTime(); // ข้อความส่งเข้า Telegram
      bot.sendMessage(CHAT_ID, successMsg, "");            // บอทส่งข้อความแจ้งเตือนความสำเร็จไปที่กลุ่ม
    }
  }

  mfrc522.PICC_HaltA();                                    // สั่งปิดการสื่อสารกับบัตรใบปัจจุบัน (ป้องกันการอ่านซ้ำรัวๆ)
  mfrc522.PCD_StopCrypto1();                               // หยุดการเข้ารหัสชั่วคราว
  delay(2000);                                             // หน่วงเวลา 2 วินาทีก่อนให้แตะครั้งต่อไป
}
