// ================= Functions เสียง =================
void soundSuccess() {
  digitalWrite(BUZZER_PIN, HIGH); delay(100); // เปิดเสียง 100 มิลลิวินาที
  digitalWrite(BUZZER_PIN, LOW);  delay(100); // ปิดเสียง 100 มิลลิวินาที
  digitalWrite(BUZZER_PIN, HIGH); delay(100); // เปิดเสียง 100 มิลลิวินาที
  digitalWrite(BUZZER_PIN, LOW);              // ปิดเสียง (เสียงสั้น 2 ครั้ง = สำเร็จ)
}

void soundError() {
  digitalWrite(BUZZER_PIN, HIGH); delay(600); // เปิดเสียงยาว 600 มิลลิวินาที
  digitalWrite(BUZZER_PIN, LOW);              // ปิดเสียง (เสียงยาว 1 ครั้ง = ผิดพลาด)
}

void soundWarning() {
  digitalWrite(BUZZER_PIN, HIGH); delay(80);  // เปิดเสียง 80 มิลลิวินาที
  digitalWrite(BUZZER_PIN, LOW);  delay(80);  // ปิดเสียง 80 มิลลิวินาที
  digitalWrite(BUZZER_PIN, HIGH); delay(80);  // เปิดเสียง 80 มิลลิวินาที
  digitalWrite(BUZZER_PIN, LOW);              // ปิดเสียง (เสียงรัวสั้น = เตือน)
}

void stopAlarm() {
  isAlarmActive = false;                      // ปิดสถานะการแจ้งเตือน
  digitalWrite(BUZZER_PIN, LOW);              // ปิดบัซเซอร์
}

// ================= Functions เวลา =================
String getCurrentTime() {
  struct tm timeinfo;                                      // โครงสร้างสำหรับเก็บข้อมูลเวลา
  if (!getLocalTime(&timeinfo)) return "0000-00-00 00:00:00"; // ถ้าดึงเวลาไม่ได้ให้คืนค่า 0 กลับไป
  char timeStringBuff[30];                                 // สร้างตัวแปรเก็บข้อความเวลา
  strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%d %H:%M:%S", &timeinfo); // จัดรูปแบบเวลา ปี-เดือน-วัน ชั่วโมง:นาที:วินาที
  return String(timeStringBuff);                           // ส่งคืนค่าเวลาเป็น String
}

int getCurrentMinutesOfDay() {
  struct tm timeinfo;                                      // โครงสร้างสำหรับเก็บข้อมูลเวลา
  if (!getLocalTime(&timeinfo)) return -1;                 // ถ้าดึงเวลาไม่ได้ คืนค่า -1
  return (timeinfo.tm_hour * 60) + timeinfo.tm_min;        // แปลงเวลาชั่วโมงและนาทีปัจจุบันให้อยู่ในหน่วยนาทีทั้งหมด
}

int timeToMinutes(String timeStr) {
  int hour = timeStr.substring(0, 2).toInt();              // ตัดเอา 2 ตัวแรกมาแปลงเป็นตัวเลขชั่วโมง
  int min  = timeStr.substring(3, 5).toInt();              // ตัดเอา 2 ตัวหลังมาแปลงเป็นตัวเลขนาที
  return (hour * 60) + min;                                // แปลงทั้งหมดเป็นนาที
}

// ฟังก์ชันอัปเดตเวลาและรีเซ็ตสถานะการทานยา/เตือนอย่างสมบูรณ์แบบ
void updateMealTime(String meal, String newTime) {
  newTime.trim();                                          // ลบช่องว่างหน้า-หลังของเวลาใหม่
  if (meal == "morning") {                                 // ถ้าเป็นมื้อเช้า
    morningTime = newTime;                                 // อัปเดตเวลามื้อเช้า
    morningTaken = false;                                  // รีเซ็ตสถานะการทานยา
    morningDueNotified = false;                            // รีเซ็ตการแจ้งเตือน
    morningOverdueNotified = false;                        // รีเซ็ตการแจ้งเตือนเลยเวลา
  } 
  else if (meal == "noon") {                               // ถ้าเป็นมื้อเที่ยง
    noonTime = newTime;                                    // อัปเดตเวลามื้อเที่ยง
    noonTaken = false;                                     // รีเซ็ตสถานะต่างๆ
    noonDueNotified = false;
    noonOverdueNotified = false;
  } 
  else if (meal == "evening") {                            // ถ้าเป็นมื้อเย็น
    eveningTime = newTime;                                 // อัปเดตเวลามื้อเย็น
    eveningTaken = false;                                  // รีเซ็ตสถานะต่างๆ
    eveningDueNotified = false;
    eveningOverdueNotified = false;
  }
  stopAlarm();                                             // ปิดเสียงเตือน (ถ้าดังอยู่)
  Serial.println("-> อัปเดตเวลาทานยา " + meal + " เป็น " + newTime + " พร้อมรีเซ็ตสถานะเรียบร้อย"); // แจ้ง Log บน Serial Monitor
}

void sendRFIDLog(String statusText, String uidStr, String nextMeal = "", String nextTime = "") {
  DynamicJsonDocument doc(256);                            // สร้างเอกสาร JSON ขนาด 256 ไบต์
  statusText.trim();                                       // ลบช่องว่าง
  doc["status"] = statusText;                              // กำหนดค่าคีย์ "status"
  doc["uid"]    = uidStr;                                  // กำหนดค่าคีย์ "uid"
  if (nextMeal != "") doc["next_meal"] = nextMeal;         // ถ้ามีมื้อถัดไป ให้ใส่ใน JSON
  if (nextTime != "") doc["next_time"] = nextTime;         // ถ้ามีเวลาถัดไป ให้ใส่ใน JSON

  char buffer[256];                                        // สร้างบัฟเฟอร์ข้อความ
  serializeJson(doc, buffer);                              // แปลง JSON ลงในบัฟเฟอร์
  client.publish(topic_log, buffer);                       // ส่งข้อมูล (Publish) ไปที่ MQTT Topic 
}

void checkDayReset() {
  struct tm timeinfo;                                      // โครงสร้างตัวแปรเวลา
  if (getLocalTime(&timeinfo)) {                           // ดึงเวลามาเช็ก
    if (timeinfo.tm_mday != currentDay) {                  // ถ้าวันที่ปัจจุบันไม่ตรงกับที่บันทึกไว้ (แสดงว่าขึ้นวันใหม่)
      currentDay = timeinfo.tm_mday;                       // อัปเดตวันที่เป็นวันใหม่
      morningTaken = false;   noonTaken = false;   eveningTaken = false; // รีเซ็ตการทานยาทุกมื้อเป็น 'ยังไม่ทาน'
      morningDueNotified = false;     noonDueNotified = false;     eveningDueNotified = false; // รีเซ็ตการแจ้งเตือน
      morningOverdueNotified = false; noonOverdueNotified = false; eveningOverdueNotified = false; // รีเซ็ตการแจ้งเตือนเกินเวลา
      stopAlarm();                                         // ปิดเสียง
      Serial.println("-> วันใหม่: รีเซ็ตสถานะการทานยาทั้งหมด"); // พิมพ์แจ้งใน Serial Monitor
    }
  }
}

String getValidMealNow() {
  int nowMins = getCurrentMinutesOfDay();                  // ดูว่าตอนนี้กี่นาทีของวันแล้ว
  if (nowMins == -1) return "none";                        // ถ้าดึงเวลาไม่ได้ให้ออกไป

  int mTime = timeToMinutes(morningTime);                  // แปลงเวลามื้อเช้าเป็นนาที
  int nTime = timeToMinutes(noonTime);                     // แปลงเวลามื้อเที่ยงเป็นนาที
  int eTime = timeToMinutes(eveningTime);                  // แปลงเวลามื้อเย็นเป็นนาที

  if (nowMins >= mTime && !morningTaken) return "morning"; // ถ้าเลยเวลาเช้าและยังไม่ทาน -> คืนค่ามื้อเช้า
  if (nowMins >= nTime && !noonTaken) return "noon";       // ถ้าเลยเวลาเที่ยงและยังไม่ทาน -> คืนค่ามื้อเที่ยง
  if (nowMins >= eTime && !eveningTaken) return "evening"; // ถ้าเลยเวลาเย็นและยังไม่ทาน -> คืนค่ามื้อเย็น

  return "none";                                           // ถ้าทานหมดแล้ว หรือยังไม่ถึงเวลา คืนค่า none
}

void getNextMealInfo(String &nextMealName, String &nextMealTime) {
  int nowMins = getCurrentMinutesOfDay();                  // เวลาปัจจุบันเป็นนาที
  int mTime = timeToMinutes(morningTime);                  // เวลามื้อเช้า
  int nTime = timeToMinutes(noonTime);                     // เวลามื้อเที่ยง
  int eTime = timeToMinutes(eveningTime);                  // เวลามื้อเย็น

  if (nowMins < mTime) {                                   // ถ้ายังไม่ถึงมื้อเช้า
    nextMealName = "มื้อเช้า"; nextMealTime = morningTime; // บอกว่ามื้อต่อไปคือเช้า
  } else if (nowMins < nTime) {                            // ถ้าผ่านเช้าไปแล้ว แต่ยังไม่ถึงเที่ยง
    nextMealName = "มื้อเที่ยง"; nextMealTime = noonTime; // บอกว่ามื้อต่อไปคือเที่ยง
  } else if (nowMins < eTime) {                            // ถ้าผ่านเที่ยงไปแล้ว แต่ยังไม่ถึงเย็น
    nextMealName = "มื้อเย็น"; nextMealTime = eveningTime; // บอกว่ามื้อต่อไปคือเย็น
  } else {                                                 // ถ้าเลยมื้อเย็นไปแล้ว
    nextMealName = "มื้อเช้า (วันถัดไป)"; nextMealTime = morningTime; // บอกว่ามื้อต่อไปคือเช้าพรุ่งนี้
  }
}

// ระบบตรวจสอบการเตือนทานยาแบบประเมินเงื่อนไขยืดหยุ่น
void checkPillTimeAlerts() {
  int nowMins = getCurrentMinutesOfDay();                  // เวลาปัจจุบัน
  if (nowMins == -1) return;                               // ถ้าดึงเวลาล้มเหลว ออกจากฟังก์ชัน

  int mTime = timeToMinutes(morningTime);                  // เวลามื้อเช้าเป็นนาที
  int nTime = timeToMinutes(noonTime);                     // เวลามื้อเที่ยงเป็นนาที
  int eTime = timeToMinutes(eveningTime);                  // เวลามื้อเย็นเป็นนาที

  // --- เช็กมื้อเช้า ---
  if (!morningTaken) {                                     // ถ้ายังไม่ทานมื้อเช้า
    if (nowMins >= mTime && nowMins < (mTime + 15)) {      // ถ้าอยู่ในช่วง 15 นาทีหลังจากถึงเวลา
      if (!morningDueNotified) {                           // ถ้ายังไม่ได้เตือน
        morningDueNotified = true; isAlarmActive = true;   // ตั้งสถานะว่าเตือนแล้ว และเปิดระบบแจ้งเตือน
        bot.sendMessage(CHAT_ID, "⏰ [ถึงเวลาทานยา!] กรุณาแตะบัตรเพื่อรับยามื้อเช้า", ""); // แจ้งผ่าน Telegram
      }
    } else if (nowMins >= (mTime + 15)) {                  // ถ้าเกิน 15 นาทีไปแล้ว
      if (!morningOverdueNotified) {                       // ถ้ายังไม่แจ้งเตือนเกินเวลา
        morningDueNotified = true; morningOverdueNotified = true; isAlarmActive = true; // อัปเดตว่าเตือนทั้ง 2 แบบแล้ว
        bot.sendMessage(CHAT_ID, "⚠️ [เลยเวลาทานยา 15 นาที!] กรุณามาแตะบัตรเพื่อรับยามื้อเช้าด่วน!", ""); // แจ้งใน Telegram ว่าเลยเวลา
      }
    }
  }

  // --- เช็กมื้อเที่ยง ---
  if (!noonTaken) {                                        // ถ้ายังไม่ทานมื้อเที่ยง (กระบวนการเหมือนมื้อเช้า)
    if (nowMins >= nTime && nowMins < (nTime + 15)) {
      if (!noonDueNotified) {
        noonDueNotified = true; isAlarmActive = true;
        bot.sendMessage(CHAT_ID, "⏰ [ถึงเวลาทานยา!] กรุณาแตะบัตรเพื่อรับยามื้อเที่ยง", "");
      }
    } else if (nowMins >= (nTime + 15)) {
      if (!noonOverdueNotified) {
        noonDueNotified = true; noonOverdueNotified = true; isAlarmActive = true;
        bot.sendMessage(CHAT_ID, "⚠️ [เลยเวลาทานยา 15 นาที!] กรุณามาแตะบัตรเพื่อรับยามื้อเที่ยงด่วน!", "");
      }
    }
  }

  // --- เช็กมื้อเย็น ---
  if (!eveningTaken) {                                     // ถ้ายังไม่ทานมื้อเย็น (กระบวนการเหมือนมื้อเช้า)
    if (nowMins >= eTime && nowMins < (eTime + 15)) {
      if (!eveningDueNotified) {
        eveningDueNotified = true; isAlarmActive = true;
        bot.sendMessage(CHAT_ID, "⏰ [ถึงเวลาทานยา!] กรุณาแตะบัตรเพื่อรับยามื้อเย็น", "");
      }
    } else if (nowMins >= (eTime + 15)) {
      if (!eveningOverdueNotified) {
        eveningDueNotified = true; eveningOverdueNotified = true; isAlarmActive = true;
        bot.sendMessage(CHAT_ID, "⚠️ [เลยเวลาทานยา 15 นาที!] กรุณามาแตะบัตรเพื่อรับยามื้อเย็นด่วน!", "");
      }
    }
  }

  // --- ระบบส่งเสียง Buzzer เตือน ---
  if (isAlarmActive) {                                     // ถ้าอยู่ในสถานะต้องส่งเสียงเตือน
    bool isOverdue = (morningOverdueNotified || noonOverdueNotified || eveningOverdueNotified); // เช็กว่ามีการเลยเวลาทานยาหรือไม่
    if (isOverdue) {                                       // กรณีเลยเวลา
      if (millis() - lastBuzzerAlertTime >= 1500 || lastBuzzerAlertTime == 0) { // ทุก 1.5 วินาที
        digitalWrite(BUZZER_PIN, HIGH); delay(400);        // เสียงยาว 400ms
        digitalWrite(BUZZER_PIN, LOW);  delay(100);        // เว้น 100ms
        digitalWrite(BUZZER_PIN, HIGH); delay(400);        // เสียงยาว 400ms
        digitalWrite(BUZZER_PIN, LOW);                     // ปิดเสียง
        lastBuzzerAlertTime = millis();                    // อัปเดตเวลาล่าสุดที่เสียงดัง
      }
    } else {                                               // กรณีพึ่งถึงเวลาเตือนปกติ (ยังไม่เกิน)
      if (millis() - lastBuzzerAlertTime >= 60000 || lastBuzzerAlertTime == 0) { // เตือนทุกๆ 60 วินาที
        digitalWrite(BUZZER_PIN, HIGH); delay(150);        // เสียงสั้น 150ms
        digitalWrite(BUZZER_PIN, LOW);  delay(100);        // เว้น 100ms
        digitalWrite(BUZZER_PIN, HIGH); delay(150);        // เสียงสั้น 150ms
        digitalWrite(BUZZER_PIN, LOW);                     // ปิดเสียง
        lastBuzzerAlertTime = millis();                    // อัปเดตเวลาล่าสุดที่เสียงดัง
      }
    }
  } else {                                                 // ถ้าไม่มีอะไรต้องเตือน
    digitalWrite(BUZZER_PIN, LOW);                         // ปิดบัซเซอร์ให้สนิท
  }
}

float checkPillDistance() {
  digitalWrite(TRIG_PIN, LOW); delayMicroseconds(2);       // รีเซ็ตขาส่งคลื่นอัลตราโซนิก
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);     // ปล่อยคลื่น 10 ไมโครวินาที
  digitalWrite(TRIG_PIN, LOW);                             // หยุดปล่อย
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);          // จับเวลาคลื่นสะท้อนกลับ
  return duration * 0.034 / 2;                             // คำนวณความเร็วเสียงเป็นระยะทาง (เซนติเมตร)
}

// ================= ฟังก์ชันจ่ายยาตามองศาที่ระบุ =================
void dispensePill(String mealName) {
  int targetAngle = 0;                                     // องศาเริ่มต้น

  if (mealName == "morning")      targetAngle = 35;        // มื้อเช้า หมุนไป 35 องศา
  else if (mealName == "noon")    targetAngle = 105;       // มื้อเที่ยง หมุนไป 105 องศา
  else if (mealName == "evening") targetAngle = 170;       // มื้อเย็น หมุนไป 170 องศา
  else targetAngle = 35;                                   // ค่าเริ่มต้น

  myServo.write(targetAngle);                              // สั่งเซอร์โวให้หมุนไปตามองศาที่ตั้งไว้
  delay(2000);                                             // ค้างไว้ 2 วินาทีให้ยาหล่นลงมา
  myServo.write(0);                                        // หมุนกลับมาตำแหน่ง 0 องศาเตรียมพร้อมใหม่
}

